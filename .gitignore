__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- IDEs & OS Meta ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Databases, Storage & Snapshots ---
storage/
**/storage/
*.db
*.sqlite
*.sqlite3
trading_history.db

# --- Logs ---
*.log
*.log*
logs/

