# ==============================================================================
# QuantCore Sovereign Server — Universal Environment Configuration
# ==============================================================================

# --- 1. Binance Futures API (Підтримує Demo / Testnet та Live) ---
TESTNET_API_KEY="your_binance_api_key_here"
TESTNET_SECRET_KEY="your_binance_secret_key_here"
USE_DEMO_TRADING="true"
EXCHANGE_LEVERAGE="3"

# --- 2. Telegram Bot Alert, Control & Hot-Swap (.joblib upload) ---
TELEGRAM_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# --- 3. Google Gemini AI (Macro News Sentiment Filter) ---
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"
ENABLE_NEWS_SENTIMENT="true"

# --- 4. Web Terminal & FastAPI Gateway (Порт 8501 вже відкритий у вашому VPS) ---
DASHBOARD_URL="http://localhost:8501"
DASHBOARD_PASSWORD="change_this_secure_password"
SERVER_HOST="0.0.0.0"
SERVER_PORT="8501"

# --- 5. Multi-Asset Portfolio & Risk Orchestrator ---
# Доступні профілі: CONSERVATIVE (1.6x), OPTIMAL (2.4x), AGGRESSIVE (3.2x), OVERDRIVE (3.5x)
RISK_PROFILE="OPTIMAL"
# Режим роботи: PORTFOLIO_SYNERGY (командне ядро V23) або SOLO_MAX (індивідуальні ядра V23)
ORCHESTRATOR_MODE="PORTFOLIO_SYNERGY"
ACTIVE_SYMBOLS="BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT"
ENABLE_ONLINE_LEARNING="true"

# --- 6. Захист капіталу та диска (1GB RAM VPS Eco) ---
MAX_DAILY_LOSS_PCT="0.06"
MAX_STORAGE_MB="250"
