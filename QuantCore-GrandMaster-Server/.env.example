# ==============================================================================
# QuantCore Sovereign Server — V3.5 All-Weather (5-Sleeve + Shadow Arena) Profile
# ==============================================================================

# --- 1. Binance USD-M Futures API (Demo / Testnet за замовчуванням) ---
TESTNET_API_KEY="your_binance_demo_or_testnet_api_key_here"
TESTNET_SECRET_KEY="your_binance_demo_or_testnet_secret_key_here"
USE_DEMO_TRADING="true"
EXCHANGE_LEVERAGE="5"

# Точна репетиція стартового реального депозиту $500 на Testnet (навіть якщо на Demo лежать 10,000 USDT!).
# При переході на реальні гроші (USE_DEMO_TRADING="false") вимикається автоматично.
VIRTUAL_EQUITY_CAP="500.0"

# Паралельний живий чемпіонат 6 моделей і депозитів ($500 / $2,000 / $10,000 / V3.0 / V2 / V58):
ENABLE_SHADOW_ARENA="true"

# --- 2. Telegram Bot Control, Arena Leaderboard, ZIP Export & OTA ---
TELEGRAM_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# --- 3. Google Gemini AI + Multi-RSS News & Geo-Shock Shield ---
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
ENABLE_NEWS_SENTIMENT="true"

# --- 4. Web Terminal & FastAPI Gateway (Zero-Idle CPU, <250MB Linux VPS RAM) ---
DASHBOARD_URL="http://localhost:8501"
# Повний адмін-доступ (керування, паніка, рестарт, завантаження картриджів):
DASHBOARD_PASSWORD="change_this_secure_admin_password"
# Опційний пароль тільки для перегляду (Read-Only, усі кнопки заблоковано):
# DASHBOARD_VIEW_PASSWORD=""
# Альтернатива: окремий файл з адмін-ключем поза .env (chmod 600):
# DASHBOARD_ADMIN_KEY_FILE="/srv/quantcore/.admin_key"
SERVER_HOST="127.0.0.1"
SERVER_PORT="8501"
COOKIE_SECURE="true"
ALLOW_CARTRIDGE_UPLOAD="false"
ENABLE_API_DOCS="false"
ALLOW_QUERY_KEY_AUTH="false"

# --- 5. Ядро стратегії: V5.0 All-Regime Sovereign (49 фіч + 37-фічевий Dual-ML + MFE Harvester на 58 парах) ---
CARTRIDGE_ENGINE="v5"
CANDLE_TIMEFRAME="1h"
CANDLE_INTERVAL_MINUTES="60"
V2_CANDLES_FETCH_LIMIT="820"
V2_MAKER_WAIT_SEC="3.5"
V3_URGENT_MAKER_WAIT_SEC="1.8"
V3_SHORT_SQUEEZE_ATR_MULT="5.0"
ENABLE_V3_AUX_CHANNELS="true"
FUNDING_HISTORY_HOURS="720"
NEUTRALITY_IMBALANCE_LIMIT="0.25"
MAX_CANDLE_STALENESS_MULT="2.3"

# Залиште порожнім для автоматичного вибору повного UNIVERSE_58 (при v3) або UNIVERSE_32 (при v2):
# ACTIVE_SYMBOLS=""

# --- 6. Профіль ризику та апаратні квоти (1GB RAM VPS Eco) ---
RISK_PROFILE="AGGRESSIVE"
ORCHESTRATOR_MODE="PORTFOLIO_SYNERGY"
ENABLE_ONLINE_LEARNING="false"
MAX_DAILY_LOSS_PCT="0.06"
MAX_ALLOWED_SPREAD_PCT="0.0055"
MAX_STORAGE_MB="250"
SERVER_NUMBA_THREADS="2"

# --- 7. V6.2-B Smart Maker Post-Only (GTX) Chase & Implementation Shortfall ---
# За замовчуванням ВИМКНЕНО на час burn-in V6.2-A; вмикається контрольовано після 48-72h обкатки.
SMART_MAKER_CHASE_ENABLED="false"
SMART_MAKER_MAX_ATTEMPTS="3"
SMART_MAKER_POLL_SEC="12.0"
SMART_MAKER_REPRICE_BPS="3.0"
SMART_MAKER_MAX_DRIFT_BPS="25.0"
SMART_MAKER_MIN_NOTIONAL_USD="15.0"
SMART_MAKER_CONCURRENCY="4"
