# ==============================================================================
# QuantCore V7.8 Ultra - Environment Configuration
# Скопіюйте цей файл як .env та заповніть ваші власні API ключі:
# cp .env.example .env
# ==============================================================================

# --- Binance Futures API (Testnet / Live) ---
TESTNET_API_KEY="your_binance_api_key_here"
TESTNET_SECRET_KEY="your_binance_secret_key_here"

# --- Telegram Bot Alert & Control ---
# Створіть бота через @BotFather та отримайте токен
TELEGRAM_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# Ваш Telegram Chat ID (можна дізнатися через @userinfobot)
TELEGRAM_CHAT_ID="123456789"

# --- Google Gemini AI (News Sentiment Analysis) ---
# Отримайте безкоштовний ключ на https://aistudio.google.com/
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# --- Web Terminal Dashboard (Streamlit) ---
# Зовнішня або локальна адреса дашборду для кнопок у Telegram
DASHBOARD_URL="http://localhost:8501"
# Пароль для доступу до веб-терміналу
DASHBOARD_PASSWORD="change_this_secure_password"

# --- Risk & Execution Profile ---
# Доступні профілі: CONSERVATIVE (0.75x-1.00x), OPTIMAL (0.80x-1.30x), AGGRESSIVE (1.00x-1.50x)
RISK_PROFILE="OPTIMAL"

